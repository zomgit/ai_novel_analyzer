# 示例 1: SiliconFlow 完整配置
AI_MODEL_API_KEY="sf-abc123def456ghi789jkl012mno345pqr678stu901"
SILICONFLOW_API_KEY="sf-xyz987wvu654tsr321qpo098nml765kji432hgf109"

# 示例 2: OpenAI + SiliconFlow 组合
AI_MODEL_API_KEY="sk-your-openai-key-here"
SILICONFLOW_API_KEY="sf-your-siliconflow-embedding-key-here"

# 示例 3: Groq + SiliconFlow
AI_MODEL_API_KEY="gpk-your-groq-key-here"
SILICONFLOW_API_KEY="sf-your-siliconflow-embedding-key-here"

# 示例 4: 完全离线（Ollama）
# AI_MODEL_API_KEY=""  # 留空或不设置
# SILICONFLOW_API_KEY=""  # 留空或不设置


